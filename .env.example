# Environment variables
# Add your environment variables here

# API Configuration
# HYU 직접 연결 예시
API_BASE_URL=https://api.api
GOOGLE_CLIENT_ID="<서버가 검증하는 Google OAuth Web Client ID>"
#
# 개발 시 API_BASE_URL을 설정하지 않으면 플랫폼별로 자동 선택됩니다:
#   - Android 에뮬레이터: http://10.0.2.2:8000
#   - iOS 시뮬레이터/데스크톱: http://localhost:8000
# 실기기 테스트 시 PC의 로컬 IP를 넣어주세요. (예: http://192.168.0.10:8000)
# 배포 빌드 또는 임시 실행에서는 --dart-define 값이 .env.local보다 우선 적용됩니다.
# 선택값: 미설정 시 API_BASE_URL 기준으로 자동 변환(http->ws, https->wss)
# API_WS_BASE_URL=ws://10.0.2.2:8000

# OneSignal Configuration
# Get this from your OneSignal dashboard
# ⚠️ 팀 내부 프로젝트 전용: 실제 배포 시에는 서버사이드로 마이그레이션 필요
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here  # 팀 내부에서만 사용

# Firebase Configuration
# Get these from your Firebase console
FIREBASE_PROJECT_NUMBER=your_firebase_project_number_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_MOBILESDK_APP_ID=your_firebase_mobilesdk_app_id_here
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_CLIENT_ID=your_firebase_client_id_here
FIREBASE_IOS_CLIENT_ID=your_firebase_ios_client_id_here
FIREBASE_CLIENT_ID_ANDROID_CERT2=your_firebase_android_client_id_cert2_here
FIREBASE_CLIENT_ID_WEB=your_firebase_web_client_id_here